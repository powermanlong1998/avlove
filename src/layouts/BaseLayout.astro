---
interface Props {
  title?: string;
  description?: string;
}

const { title = 'AVLove - 女优资料库', description = '日本、欧美、韩国、国产女优搜索' } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style is:global>
      *,
      *::before,
      *::after {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body {
        font-family: "Microsoft YaHei", "PingFang SC", "Hiragino Sans GB",
          "Segoe UI", sans-serif;
        background: #f5f5f7;
        color: #333;
        min-height: 100vh;
        line-height: 1.6;
      }
      a {
        text-decoration: none;
        color: inherit;
      }
      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
      }
      @keyframes fadeIn {
        from {
          opacity: 0;
          transform: translateY(10px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      .fade-in {
        animation: fadeIn 0.4s ease-out;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>